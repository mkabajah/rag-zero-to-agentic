{
  "mcpServers": {
    "rag-lab": {
      "command": ".venv/bin/python",
      "args": [
        "lab/mcp_server.py"
      ],
      "env": {
        "RAG_ROLE": "employee",
        "RAG_CORPUS": "company"
      },
      "disabled": false,
      "autoApprove": [
        "search_docs",
        "get_document",
        "graph_neighbors"
      ]
    },
    "cv-desk": {
      "command": ".venv/bin/python",
      "args": [
        "lab/mcp_server.py"
      ],
      "env": {
        "RAG_ROLE": "employee",
        "RAG_CORPUS": "cvs"
      },
      "disabled": false,
      "autoApprove": [
        "search_docs",
        "get_document",
        "graph_neighbors",
        "list_jobs",
        "find_candidates"
      ]
    },
    "cv-agent": {
      "command": ".venv/bin/python",
      "args": [
        "challenge/mcp_server.py"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "search_cvs",
        "get_cv",
        "find_candidates",
        "list_jobs"
      ]
    }
  }
}
